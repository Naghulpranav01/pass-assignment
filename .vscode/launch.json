{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Launch Packaged Workbench (One-Action)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/Launch.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/build_tools/w64devkit/bin/gdb.exe"
    },
    {
      "name": "2. Run C++ Unit & Numerical Tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/run_tests.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "3. Run Backend Server (CLI Mode)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/workbench_server.exe",
      "args": ["--port", "8080"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb"
    }
  ]
}
